<odoo>
  <record id="sale_report_wizard_form" model="ir.ui.view">
    <field name="name">sale.report.wizard.form</field>
    <field name="model">sale.report.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="date_start"/>
            <field name="date_end"/>
            <!-- <field name="channel_ids" options="{'no_create_edit' : True}"  widget="many2many_tags"/> -->
            <field name="product_id" options="{'no_create_edit' : True}"/>
            <field name="partner_id" options="{'no_create' : True}"/>
            <field name="export_type"/>
            <field name="company_id" readonly="1"/>
          </group>
        </sheet>
        <footer>
          <button string="Acept" type="object" name="ok" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn btn-danger" />
        </footer>
      </form>
    </field>
  </record>
  <record id="action_sale_report" model="ir.actions.act_window">
    <field name="name">Report Sales</field>
    <field name="res_model">sale.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <menuitem id="sale_report" action="action_sale_report" parent="sale.menu_sale_report" sequence="2"/>
</odoo>